# Copy to .env and fill in before running.
#   cp .env.example .env

# --- Database (Neon Postgres) ---------------------------------------------
# DATABASE_URL is the POOLED connection ("-pooler" in the host) used at runtime.
# DIRECT_URL is the DIRECT connection, used by `prisma migrate`. Connection
# poolers can break migrations, which is why these are separate.
# Both are on your Neon dashboard under Connection Details.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Auth -----------------------------------------------------------------
# Required. Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# --- Site -----------------------------------------------------------------
# Your real domain in production — used for canonical URLs, OG tags, sitemap.xml
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Image uploads --------------------------------------------------------
# Set in production (Vercel injects it when you create a Blob store).
# Leave blank locally and uploads fall back to writing into public/uploads.
BLOB_READ_WRITE_TOKEN=""

# --- Seeding --------------------------------------------------------------
# The main admin created by `npm run db:seed`. Change both before seeding,
# and change the password again after your first login.
SEED_SUPER_ADMIN_EMAIL="admin@example.com"
SEED_SUPER_ADMIN_PASSWORD=""
