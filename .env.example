# Copy to .env and fill in before running.
#   cp .env.example .env

DATABASE_URL="file:./dev.db"

# Required. Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Your real domain in production — used for canonical URLs, OG tags and sitemap.xml
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# The main admin created by `npm run db:seed`. Change both before seeding,
# and change the password again after your first login.
SEED_SUPER_ADMIN_EMAIL="admin@example.com"
SEED_SUPER_ADMIN_PASSWORD=""
