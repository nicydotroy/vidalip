# Copy to .env and fill in before running.
#   cp .env.example .env

# --- Database (Neon Postgres) ---------------------------------------------
# DATABASE_URL is the POOLED connection ("-pooler" in the host), used at runtime.
# DIRECT_URL is the DIRECT connection, used by `prisma migrate` — poolers can
# interfere with migrations. It is OPTIONAL: leave it unset and migrations fall
# back to DATABASE_URL with a warning.
# Both strings are on your Neon dashboard under Connection Details.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Auth -----------------------------------------------------------------
# Required. Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# --- Site -----------------------------------------------------------------
# Your real domain in production — used for canonical URLs, OG tags, sitemap.xml
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Image uploads --------------------------------------------------------
# Set in production (Vercel injects it when you create a Blob store).
# Leave blank locally and uploads fall back to writing into public/uploads.
BLOB_READ_WRITE_TOKEN=""

# --- Seeding --------------------------------------------------------------
# The main admin created by `npm run db:seed`. Both are required — there is no
# default password. Minimum 12 characters; generate one with:
#   openssl rand -base64 24
# Re-seeding never resets an existing admin's password.
SEED_SUPER_ADMIN_EMAIL="admin@example.com"
SEED_SUPER_ADMIN_PASSWORD=""
